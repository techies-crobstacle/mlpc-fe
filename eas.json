{
  "cli": {
    "version": ">= 16.20.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20",
      "env": {
        "NODE_VERSION": "20"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20",
      "env": {
        "NODE_VERSION": "20"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20",
      "env": {
        "NODE_VERSION": "20"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "20",
      "env": {
        "NODE_VERSION": "20"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
